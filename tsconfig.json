{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "tests/**/*.ts",
    "vitest.config.ts",
    "scripts/build.ts",
    "scripts/verify-package.ts"
  ],
  "exclude": ["node_modules"]
}
