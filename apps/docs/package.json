{
  "name": "@issue-graph/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm sync:skill && next dev",
    "build": "pnpm sync:skill && fumadocs-mdx && next build",
    "sync:skill": "tsx scripts/sync-skill.ts",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "biome check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:routes": "tsx scripts/test-routes.ts",
    "test:ci": "tsx scripts/verify-site.ts",
    "audit": "tsx scripts/audit.ts",
    "generate:demo": "tsx scripts/generate-demo.ts"
  },
  "dependencies": {
    "@vercel/agent-readability": "0.7.0",
    "@vercel/geistdocs": "2.4.1",
    "@wterm/dom": "0.5.0",
    "@wterm/react": "0.5.0",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4",
    "fumadocs-ui": "16.2.2",
    "geist": "1.7.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
